{
  "name": "site-app",
  "version": "0.10.24",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "prisma generate && astro dev",
    "build": "prisma generate && astro build",
    "preview": "astro preview",
    "test": "prisma generate && vitest run",
    "test:coverage": "prisma generate && vitest run --coverage --pool=threads",
    "studio": "prisma studio --browser none --port 5555",
    "platform": "node scripts/platform.mjs",
    "lint": "oxlint -c oxlint.json --deny-warnings src tests scripts/check.mjs vitest.config.ts astro.config.mjs prisma.config.ts",
    "check": "node scripts/check.mjs",
    "setup": "node scripts/platform.mjs setup",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "dev-admin": "node scripts/platform.mjs dev-admin"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@dnd-kit/react": "^0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/adapter-ppg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/ppg": "1.0.1",
    "@stripe/stripe-js": "10.1.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@videojs/hlsjs-video": "10.3.0",
    "@videojs/react": "10.3.0",
    "@videojs/vimeo-video": "10.3.0",
    "@videojs/youtube-video": "10.3.0",
    "astro": "^7.4.7",
    "bowser": "^2.14.1",
    "country-flag-icons": "^1.6.20",
    "hono": "^4.13.16",
    "libphonenumber-js": "^1.13.15",
    "pg-types": "4.0.2",
    "postgres-array": "3.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "signature_pad": "^5.1.4",
    "uqr": "0.1.3",
    "xss": "^1.0.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "^4.10.2",
    "oxlint": "1.88.0",
    "prisma": "7.10.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "workerd@1.20261101.1": true,
    "@prisma/engines@7.10.1": true,
    "fsevents": false
  }
}
