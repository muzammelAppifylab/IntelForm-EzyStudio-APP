// The Site Database's schema (Prisma ORM 7). Change it, then run
// `npx prisma migrate dev --create-only --name <what-changed>` against the
// Preview Database, wrap the new migration.sql in BEGIN; … COMMIT;, apply it
// with `npx prisma migrate dev`, then `npx prisma generate` (docs/agent/database.md).
//
// Tables marked MANAGED belong to the template's auth core (src/platform/auth):
// add columns to them only through a template upgrade.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // The client runs in the Cloudflare Workers runtime, never in Node.
  runtime         = "workerd"
  // ONE SQL query per read: a nested `select` of related rows is joined in the database instead
  // of one extra query per relation (each query is a round trip). docs/agent/database.md.
  previewFeatures = ["relationJoins"]
}

// TESTS ONLY: the same client for Node, so `npm test` can run the real Site API
// against a real Postgres (vitest aliases the import to it). Never imported by
// site code; git-ignored like the one above.
generator nodeClient {
  provider        = "prisma-client"
  output          = "../src/generated/prisma-node"
  runtime         = "nodejs"
  previewFeatures = ["relationJoins"]
}

// The connection string is NOT here: prisma.config.ts reads DATABASE_URL from
// the environment, which the platform sets (the Build never gets one).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- auth (MANAGED)

/// A person with an account on this site. `email` is stored trimmed and
/// lower-cased. Only the user and holders of `site:user:read` ever see it.
model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(254)
  /// The platform's opaque id, on the site owner's account only (src/platform/auth/owner.ts).
  platformOwnerId   String?   @unique @map("platform_owner_id") @db.VarChar(64)
  /// A versioned hash string (src/platform/auth/password.ts).
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  name              String    @db.VarChar(80)
  /// `active` or `suspended`.
  status            String    @default("active") @db.VarChar(16)
  emailVerifiedAt   DateTime? @map("email_verified_at")
  /// Bumped on password change, logout-all and suspension: every access token
  /// carrying an older value stops working at once.
  sessionVersion    Int       @default(1) @map("session_version")
  lastLoginAt       DateTime? @map("last_login_at")
  /// Two-step sign-in (src/platform/auth/two-factor.ts): the authenticator secret, SEALED
  /// (never in clear), set once the user confirmed a first code (`totpEnabledAt`).
  totpSecretSealed  String?   @map("totp_secret_sealed") @db.VarChar(255)
  /// A secret shown during setup, not yet confirmed with a code.
  totpPendingSealed String?   @map("totp_pending_sealed") @db.VarChar(255)
  totpEnabledAt     DateTime? @map("totp_enabled_at")
  /// The 30-second step of the last accepted code: that code (and older) never works again.
  totpLastStep      Int?      @map("totp_last_step")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  roles              UserRole[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  emailChanges       EmailChange[]
  recoveryCodes      RecoveryCode[]
  signInCodes        SignInCode[]

  // IntelForm (relation lists only: no columns on this managed table).
  formsCreated       Form[]              @relation("FormCreatedBy")
  formsUpdated       Form[]              @relation("FormUpdatedBy")
  formVersions       FormVersion[]
  themes             Theme[]
  templates          Template[]
  formPrefs          UserFormPref[]
  prefs              UserPref[]
  responseTablePrefs ResponseTablePref[]
  formPresence       FormPresence[]
  intelformSettings  IntelformSettings[]
  intelformExports   IntelformExport[]

  @@index([status, id])
  @@map("users")
}

/// A role: a named set of permissions. `is_system` roles (owner, admin,
/// member) are seeded and cannot be deleted; `owner` cannot be edited.
model Role {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(48)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// The permission catalogue: one row per codename (`site:form:read`,
/// `site:user:*`, `*`). Shipped as idempotent migrations, matched by codename.
model Permission {
  id          Int      @id @default(autoincrement())
  codename    String   @unique @db.VarChar(128)
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  /// Groups the catalogue in the roles screen ("Users", "Jobs").
  groupName   String   @default("General") @map("group_name") @db.VarChar(48)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  grantedBy    Int?     @map("granted_by")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  grantedBy Int?     @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId, userId])
  @@map("user_roles")
}

/// One refresh token, stored only as its SHA-256. Tokens of one sign-in share
/// a `family_id`; each rotation marks the old row used and points the new
/// row at it (`rotated_from`). Reuse of a used token revokes the family.
model RefreshToken {
  id                BigInt    @id @default(autoincrement())
  familyId          String    @map("family_id") @db.Uuid
  userId            Int       @map("user_id")
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  rotatedFromId     BigInt?   @map("rotated_from")
  usedAt            DateTime? @map("used_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.VarChar(16)
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ipHash            String?   @map("ip_hash") @db.Char(64)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A single-use password reset link (30 minutes), stored as its SHA-256.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipHash    String?   @map("ip_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_resets")
}

/// A single-use email confirmation link (24 hours), stored as its SHA-256.
model EmailVerification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  /// The address this link confirms (the user's email when it was sent).
  email     String    @db.VarChar(254)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

/// A 6-digit sign-in code emailed to the account (src/platform/auth/code-routes.ts): 10 minutes,
/// single use, 5 wrong tries and it is spent. Only its keyed hash is stored. A new code ends the
/// older ones.
model SignInCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  tries     Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipHash    String?   @map("ip_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("sign_in_codes")
}

/// Rate-limit ledger: one row per attempt. Keyed hashes only (never the raw
/// email or IP). Rows older than a day are swept on the way.
/// A sign-up waiting for its emailed code. No account exists until the same browser enters the
/// code: that proves it chose this password and that it reads the inbox.
model PendingSignUp {
  id           Int       @id @default(autoincrement())
  email        String    @db.VarChar(254)
  name         String    @db.VarChar(80)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  browserHash  String    @map("browser_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  ipHash       String?   @map("ip_hash") @db.Char(64)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([email, browserHash])
  @@index([browserHash])
  @@index([expiresAt])
  @@map("pending_sign_ups")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  /// `login`, `register`, `reset`, `verify`, `password`, `code`, `codecheck`, ….
  kind      String   @db.VarChar(16)
  emailHash String?  @map("email_hash") @db.Char(64)
  ipHash    String   @map("ip_hash") @db.Char(64)
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, emailHash, createdAt])
  @@index([kind, ipHash, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Security-relevant events (sign-ups, password changes, role changes,
/// refresh-token reuse). No email addresses, no raw IPs, no secrets.
/// A pending move of an account to a new address: the link mailed to the NEW address
/// (`/account/confirm-email/?token=…`) finishes it; single use, 24 hours.
model EmailChange {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  newEmail  String    @map("new_email") @db.VarChar(254)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_changes")
}

/// Two-step sign-in recovery codes, as SHA-256 hashes; each works once.
model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String   @db.VarChar(64)
  targetType  String?  @map("target_type") @db.VarChar(32)
  targetId    String?  @map("target_id") @db.VarChar(64)
  ipHash      String?  @map("ip_hash") @db.Char(64)
  /// Small, non-personal details (`{"roles":["admin"]}`). Never filtered on.
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId, id])
  @@index([targetType, targetId, id])
  /// The Activity screen's "kind" filter (`action IN (...)`, newest first).
  @@index([action, id])
  /// The Activity screen's date range.
  @@index([createdAt])
  @@map("audit_events")
}

/// One row (`id = 1`): the account holding the owner seat, taken with a conditional
/// update, and the `SITE_OWNER_ID` this database last saw.
model AuthState {
  id          Int      @id
  ownerUserId Int?     @map("owner_user_id")
  ownerEnvId  String?  @map("owner_env_id") @db.VarChar(64)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("auth_state")
}

/// Background job deliveries already taken (`src/platform/background.ts`): the
/// replay guard for signed deliveries, across every Worker instance. One row
/// per job try; rows older than a day are swept on the way.
model JobDelivery {
  jobId   String   @map("job_id")
  attempt Int
  seenAt  DateTime @default(now()) @map("seen_at")

  @@id([jobId, attempt])
  @@index([seenAt])
  @@map("job_deliveries")
}

// ---------------------------------------------------------------- payments (MANAGED)
// Filled by src/server/payments-hooks.ts from the platform's payment events (and the thanks
// page's confirm). Add columns only through a template upgrade; keep your own data in your own
// tables, pointing at `checkout_id` / `subscription_id`.

/// Payment events already handled, by event id (`src/platform/payments.ts`): a retried or
/// replayed event runs its hook once. Rows older than 90 days are swept on the way.
model PaymentEvent {
  id         String   @id @db.VarChar(128)
  type       String   @db.VarChar(40)
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("payment_events")
}

/// One thing that must happen once (`idempotent` in src/platform/idempotency.ts): the first request
/// runs it, a repeat of the same `key` gets `response`. Kept for 7 days.
model IdempotencyKey {
  id          Int      @id @default(autoincrement())
  scope       String   @db.VarChar(120)
  key         String   @db.VarChar(64)
  fingerprint String   @db.VarChar(64)
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// One paid (or failed / refunded) checkout. `checkout_id` is the platform's `pcs_…`.
model Order {
  id          Int       @id @default(autoincrement())
  checkoutId  String    @unique @map("checkout_id") @db.VarChar(80)
  priceKey    String    @map("price_key") @db.VarChar(63)
  /// `test` (sandbox) or `live`.
  mode        String    @default("test") @db.VarChar(4)
  email       String?   @db.VarChar(254)
  /// The signed-in buyer (`users.id`), from the checkout's `customerRef`. No foreign key: an
  /// order outlives a deleted account.
  userId      Int?      @map("user_id")
  /// `paid`, `failed`, `refunded` or `partially_refunded`.
  status      String    @db.VarChar(20)
  quantity    Int       @default(1)
  amountCents Int       @map("amount_cents")
  currency    String    @db.Char(3)
  metadata    Json?
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, id])
  @@index([email, id])
  @@map("orders")
}

/// A subscription bought on this site. Access: `active`, `trialing`, `past_due`, or `canceled`
/// until `access_ends_at` (`grantsAccess` in src/platform/payments.ts).
model Membership {
  id               Int       @id @default(autoincrement())
  subscriptionId   String    @unique @map("subscription_id") @db.VarChar(128)
  priceKey         String    @map("price_key") @db.VarChar(63)
  mode             String    @default("test") @db.VarChar(4)
  email            String?   @db.VarChar(254)
  userId           Int?      @map("user_id")
  status           String    @db.VarChar(20)
  currentPeriodEnd DateTime? @map("current_period_end")
  accessEndsAt     DateTime? @map("access_ends_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId, priceKey])
  @@index([email, priceKey])
  @@map("memberships")
}

// ---------------------------------------------------------------- the site's own data

/// A job on the job board (`/jobs`, `/jobs/<slug>`). Holders of
/// `site:job:manage` post and edit them from `/portal/jobs`.
model Job {
  id          Int      @id @default(autoincrement())
  /// URL name, unique: `/jobs/<slug>`.
  slug        String   @unique @db.VarChar(120)
  title       String   @db.VarChar(120)
  company     String   @db.VarChar(80)
  location    String   @db.VarChar(80)
  /// `full-time`, `part-time`, `contract` or `internship`.
  type        String   @default("full-time") @db.VarChar(20)
  remote      Boolean  @default(false)
  /// Plain text; paragraphs separated by blank lines.
  description String   @db.VarChar(10000)
  /// Where to apply: an https URL or a mailto: link the poster chose to publish.
  applyUrl    String   @map("apply_url") @db.VarChar(500)
  /// `open` (listed) or `closed` (kept, not listed).
  status      String   @default("open") @db.VarChar(10)
  /// The user (`users.id`) who posted it. No foreign key: a job outlives its poster.
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, id])
  @@map("jobs")
}

// ---------------------------------------------------------------- IntelForm
// Forms, versions, responses and everything around them (ported from IntelForm's own schema,
// legacy/server/db/migrations). Ids are uuids: they appear in dashboard URLs and API bodies
// (`z.uuid()` in src/lib/intelform/api-*.ts). Who created or changed something points at
// `users.id` with ON DELETE SET NULL: forms and responses outlive a deleted account.
// Partial, expression and trigram indexes, CHECKs and the contact trigger are SQL in the
// migration (Prisma's schema can't hold them): open every later `--create-only` migration and
// delete any `DROP INDEX` / `DROP TRIGGER` of them before applying.

/// A form. `draft` is the editable definition (src/lib/intelform/form/definition.ts); what
/// respondents see is `publishedVersion`. `settings` is the flat FormSettings object
/// (src/lib/intelform/form/settings.ts), `theme` the FormTheme (form/theme.ts).
model Form {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Public link slug. Lower-case letters, digits and hyphens (CHECK in SQL).
  slug               String    @unique @db.VarChar(60)
  title              String    @db.VarChar(200)
  /// `draft`, `live` or `closed` (CHECK in SQL).
  status             String    @default("draft") @db.VarChar(10)
  draft              Json      @db.JsonB
  publishedVersionId String?   @unique @map("published_version_id") @db.Uuid
  settings           Json      @default("{}") @db.JsonB
  theme              Json      @default("{}") @db.JsonB
  /// The draft or theme changed since the last Publish ("Unpublished changes").
  hasUnpublished     Boolean   @default(false) @map("has_unpublished")
  /// The webhook signing secret (never in `settings`, which the browser reads). Server only.
  webhookSecret      String?   @map("webhook_secret") @db.VarChar(255)
  /// Bumped on every save: autosave conflict detection (If-Match).
  revision           Int       @default(0)
  /// Kept on write by the submit and delete routes: the forms list never counts responses.
  responseCount      Int       @default(0) @map("response_count")
  lastResponseAt     DateTime? @map("last_response_at") @db.Timestamptz(3)
  /// All-time starts, bumped with the form_event_counts upsert (respondent/events.ts).
  startsTotal        Int       @default(0) @map("starts_total")
  createdById        Int?      @map("created_by")
  updatedById        Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy         User?               @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?               @relation("FormUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedVersion  FormVersion?        @relation("FormPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions          FormVersion[]       @relation("FormVersions")
  oldSlugs          FormSlugOld[]
  responses         Response[]
  events            FormEvent[]
  eventCounts       FormEventCount[]
  webhookDeliveries WebhookDelivery[]
  userPrefs         UserFormPref[]
  tablePrefs        ResponseTablePref[]
  presence          FormPresence[]
  responseHours     FormResponseHour[]
  exports           IntelformExport[]

  @@index([updatedAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([responseCount(sort: Desc), updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([createdById])
  @@index([updatedById])
  @@map("forms")
}

/// A published snapshot of a form: what respondents fill in and what responses point at.
model FormVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId        String   @map("form_id") @db.Uuid
  /// 1, 2, 3… per form.
  version       Int
  definition    Json     @db.JsonB
  theme         Json     @db.JsonB
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedById Int?     @map("published_by")

  form         Form       @relation("FormVersions", fields: [formId], references: [id], onDelete: Cascade)
  publishedBy  User?      @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedFor Form?      @relation("FormPublishedVersion")
  responses    Response[]

  @@unique([formId, version])
  @@index([publishedById])
  @@map("form_versions")
}

/// An old slug of a form: the old public link keeps redirecting after the link changed.
model FormSlugOld {
  slug      String   @id @db.VarChar(60)
  formId    String   @map("form_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_slugs_old")
}

/// One submitted response. `answers` is `{fieldId: value}` (CHECK: a JSON object). The
/// `contact_*` columns are filled by the `responses_contact_fill` trigger from the version's
/// email / name / phone questions: contacts are these columns grouped by `contact_key`
/// ("e:<email>" or "p:<E.164 phone>"); there is no contacts table. Never write them yourself.
model Response {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId        String    @map("form_id") @db.Uuid
  formVersionId String    @map("form_version_id") @db.Uuid
  answers       Json      @db.JsonB
  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  durationMs    Int?      @map("duration_ms")
  /// Keyed hash of the respondent's IP, never the address.
  ipHash        String?   @map("ip_hash") @db.VarChar(64)
  /// ISO 3166 alpha-2.
  country       String?   @db.VarChar(2)
  /// `desktop`, `mobile` or `tablet`.
  device        String?   @db.VarChar(16)
  browser       String?   @db.VarChar(40)
  /// Hash of the one-response-per-browser token.
  browserToken  String?   @map("browser_token") @db.VarChar(64)
  /// Server-built text of the text-like answers, for search (trigram index in SQL).
  searchText    String    @default("") @map("search_text") @db.Text
  /// Time per question in ms, measured in the browser: `{fieldId: ms}`.
  ttc           Json?     @db.JsonB
  /// One response per email: the normalised address of the checked answer (partial unique index in SQL).
  emailKey      String?   @map("email_key") @db.VarChar(254)
  /// Filled by the trigger, never by code.
  contactEmail  String?   @map("contact_email") @db.VarChar(254)
  contactName   String?   @map("contact_name") @db.VarChar(200)
  contactPhone  String?   @map("contact_phone") @db.VarChar(20)
  contactKey    String?   @map("contact_key") @db.VarChar(260)

  form              Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersion       FormVersion       @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  webhookDeliveries WebhookDelivery[]

  @@index([formId, submittedAt(sort: Desc), id(sort: Desc)])
  @@index([formVersionId])
  @@index([submittedAt])
  /// Substring search (ILIKE) on search_text. Needs pg_trgm (created in the migration).
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "responses_search_trgm", type: Gin)
  /// Choice filters: `answers @> '{"f_x": "o_y"}'`.
  @@index([answers(ops: JsonbPathOps)], map: "responses_answers", type: Gin)
  @@map("responses")
}

/// A form view or start, one per browser session (the funnel). Swept after the rollup.
model FormEvent {
  id           BigInt   @id @default(autoincrement())
  formId       String   @map("form_id") @db.Uuid
  /// `view` or `start` (CHECK in SQL).
  type         String   @db.VarChar(8)
  sessionToken String   @map("session_token") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, type, sessionToken])
  @@index([createdAt])
  @@map("form_events")
}

/// Funnel rollup: views and starts per form per 15-minute bucket (correct day boundaries in
/// every time zone).
model FormEventCount {
  formId String   @map("form_id") @db.Uuid
  bucket DateTime @db.Timestamptz(3)
  views  Int      @default(0)
  starts Int      @default(0)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@id([formId, bucket])
  @@map("form_event_counts")
}

/// Responses per form per hour, kept by the responses_rollups_* triggers (SQL). The dashboard
/// strip and "new this week" read these, never the responses table.
model FormResponseHour {
  formId String   @map("form_id") @db.Uuid
  hour   DateTime @db.Timestamptz(3)
  n      Int      @default(0)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@id([formId, hour])
  @@index([hour])
  @@map("form_response_hours")
}

/// One contact (responses grouped by contact_key), kept by the responses_rollups_* triggers
/// (SQL). Lower-case name and search trigram indexes are expression indexes in the migration.
model Contact {
  key       String    @id @db.VarChar(260)
  n         Int
  firstSeen DateTime  @map("first_seen") @db.Timestamptz(3)
  lastSeen  DateTime  @map("last_seen") @db.Timestamptz(3)
  email     String?   @db.VarChar(254)
  name      String?   @db.VarChar(200)
  phone     String?   @db.VarChar(20)
  country   String?   @db.VarChar(2)
  formIds   String[]  @default([]) @map("form_ids") @db.Uuid
  formCount Int       @default(0) @map("form_count")

  @@index([lastSeen(sort: Desc), key], map: "contacts_last_seen_idx")
  @@index([firstSeen(sort: Desc), lastSeen(sort: Desc), key], map: "contacts_first_seen_idx")
  @@index([email, lastSeen(sort: Desc), key], map: "contacts_email_idx")
  @@index([n(sort: Desc), lastSeen(sort: Desc), key], map: "contacts_n_idx")
  @@index([country], map: "contacts_country_idx")
  @@index([formIds], map: "contacts_form_ids_idx", type: Gin)
  @@map("contacts")
}

/// A stored file (a signature) whose response is gone: the intelform-file-cleanup job removes
/// it from storage. Filled by the responses delete trigger (SQL).
model IntelformFileTrash {
  fileId    String   @id @map("file_id") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  attempts  Int      @default(0)

  @@index([createdAt])
  @@map("intelform_file_trash")
}

/// An export built by the intelform-exports job: `responses` (one form's CSV), `all` (every
/// form, a ZIP) or `contacts` (CSV). The file is kept in parts until a day after it is ready.
model IntelformExport {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      Int       @map("user_id")
  kind        String    @db.VarChar(16)
  formId      String?   @map("form_id") @db.Uuid
  params      Json      @default("{}") @db.JsonB
  /// `running`, `ready` or `failed` (CHECK in SQL).
  status      String    @default("running") @db.VarChar(10)
  state       Json      @default("{}") @db.JsonB
  rows        Int       @default(0)
  bytes       BigInt    @default(0)
  parts       Int       @default(0)
  fileName    String    @map("file_name") @db.VarChar(200)
  contentType String    @map("content_type") @db.VarChar(60)
  error       String?   @db.VarChar(300)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  form      Form?                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  partsData IntelformExportPart[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([formId])
  @@index([status, updatedAt])
  @@map("intelform_exports")
}

model IntelformExportPart {
  exportId String @map("export_id") @db.Uuid
  seq      Int
  data     Bytes

  export IntelformExport @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@id([exportId, seq])
  @@map("intelform_export_parts")
}

/// One webhook POST (a response, a test send or a resend). Goes with its response.
model WebhookDelivery {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId       String   @map("form_id") @db.Uuid
  responseId   String?  @map("response_id") @db.Uuid
  /// The `webhook-id` header sent: the same on a resend.
  webhookId    String?  @map("webhook_id") @db.VarChar(64)
  url          String   @db.VarChar(2000)
  statusCode   Int?     @map("status_code")
  durationMs   Int?     @map("duration_ms")
  /// First 1 KB of the endpoint's answer.
  responseBody String?  @map("response_body") @db.VarChar(1024)
  error        String?  @db.VarChar(500)
  /// What was sent, for Resend.
  payload      Json?    @db.JsonB
  isTest       Boolean  @default(false) @map("is_test")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  form     Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  response Response? @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([responseId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

/// A saved form theme (Theme tab → Saved themes), shared by the whole team.
model Theme {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(80)
  settings    Json     @db.JsonB
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdById])
  @@map("themes")
}

/// A template a teammate saved from a form ("Save as template"). The built-in templates are
/// code (src/lib/intelform/form/templates), never rows.
model Template {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  category    String   @db.VarChar(40)
  description String   @default("") @db.VarChar(300)
  definition  Json     @db.JsonB
  theme       Json     @default("{}") @db.JsonB
  settings    Json     @default("{}") @db.JsonB
  sortOrder   Int      @default(0) @map("sort_order")
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sortOrder, createdAt])
  @@index([createdById])
  @@map("templates")
}

/// Per user, per form preferences (opaque to the database).
model UserFormPref {
  userId    Int      @map("user_id")
  formId    String   @map("form_id") @db.Uuid
  prefs     Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@id([userId, formId])
  @@index([formId])
  @@map("user_form_prefs")
}

/// Per user preferences by key, e.g. `forms.view` = "grid" | "list" (key format CHECK in SQL).
model UserPref {
  userId    Int      @map("user_id")
  key       String   @db.VarChar(64)
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("user_prefs")
}

/// The Responses table's columns per user and form: ordered `[{id, visible}]`.
model ResponseTablePref {
  userId    Int      @map("user_id")
  formId    String   @map("form_id") @db.Uuid
  columns   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@id([userId, formId])
  @@index([formId])
  @@map("response_table_prefs")
}

/// Who has a form open in the builder: each tab touches its row every 20 s; rows older than
/// 45 s don't count and are swept on the way. (IntelForm kept this in memory; a Worker can't.)
model FormPresence {
  formId String   @map("form_id") @db.Uuid
  /// One id per browser tab.
  tabId  String   @map("tab_id") @db.VarChar(64)
  userId Int      @map("user_id")
  seenAt DateTime @default(now()) @map("seen_at") @db.Timestamptz(3)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([formId, tabId])
  @@index([userId])
  @@index([seenAt])
  @@map("form_presence")
}

/// Fixed-window rate limits of the public form routes (submit, unlock, events, public pages):
/// one upsert per check, keyed by the caller (`respond:<ipHash>:<formId>`, never a raw IP).
/// Ended windows are swept by a scheduled job.
model IntelformRateLimit {
  key           String   @db.VarChar(200)
  windowStart   DateTime @map("window_start") @db.Timestamptz(3)
  windowSeconds Int      @map("window_seconds")
  count         Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("intelform_rate_limits")
}

/// IntelForm's app settings: ONE row (`id = 1`, CHECK in SQL). Non-secret values only;
/// secrets are owner secrets read with `config.ownerSecret()`.
/// Emails go through the platform relay, so there are no mail provider settings here.
model IntelformSettings {
  id               Int      @id @default(1)
  // General
  appName          String   @default("IntelForm") @map("app_name") @db.VarChar(60)
  logoUrl          String?  @map("logo_url") @db.VarChar(2048)
  faviconUrl       String?  @map("favicon_url") @db.VarChar(2048)
  /// IANA time zone for dates in the dashboard and summaries.
  timezone         String   @default("UTC") @db.VarChar(64)
  /// One of DATE_FORMATS (src/lib/intelform/settings-app.ts).
  dateFormat       String   @default("DD/MM/YYYY") @map("date_format") @db.VarChar(12)
  // Branding
  /// `#RRGGBB`, or null for the design default.
  accentColor      String?  @map("accent_color") @db.VarChar(7)
  /// `light`, `dark` or `system`.
  defaultMode      String   @default("system") @map("default_mode") @db.VarChar(6)
  /// A built-in theme preset id or a saved theme's uuid; null = the built-in default.
  defaultThemeId   String?  @map("default_theme_id") @db.VarChar(100)
  // No longer read: the Turnstile spam check was removed. Kept so no saved data is dropped.
  turnstileSiteKey String?  @map("turnstile_site_key") @db.VarChar(200)
  // Data
  /// Delete responses older than this many days; null keeps them forever.
  retentionDays    Int?     @map("retention_days")
  // Public site (the forms hub)
  siteIndexing     Boolean  @default(false) @map("site_indexing")
  siteDescription  String   @default("") @map("site_description") @db.VarChar(300)
  siteOgImage      String?  @map("site_og_image") @db.VarChar(2048)
  contactEmail     String   @default("") @map("contact_email") @db.VarChar(254)
  privacyText      String   @default("") @map("privacy_text") @db.VarChar(50000)
  termsText        String   @default("") @map("terms_text") @db.VarChar(50000)
  // Notification defaults (sent through the platform's email relay)
  /// Sender name on response notifications and confirmations; null = the app name.
  emailFromName    String?  @map("email_from_name") @db.VarChar(100)
  emailReplyTo     String?  @map("email_reply_to") @db.VarChar(254)
  updatedById      Int?     @map("updated_by")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("intelform_settings")
}
