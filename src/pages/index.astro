---
/**
 * The root address: a quiet front desk. People arrive here from a form that was shared or
 * embedded (they clicked the brand, or cut the link back), or the owner and team come to sign in.
 * It says whose forms these are and stops: no hero, no pitch, nothing asking anyone to fill in
 * more. If the owner listed forms (each form's Share tab, "Show on the homepage") they appear as a
 * plain list; otherwise one line says forms are shared by link. Sign in lives in the footer.
 *
 * RENDERED PER VISIT, not prerendered: the listed forms, contact email, description, social image
 * and whether search engines may index it change in the dashboard without a Publish. It reads no
 * visitor (the footer fills the visitor in, in the browser, like a static page), so it may be kept
 * a minute, and its data comes from the Site Cache (src/server/intelform/public-site/data.ts).
 *
 * Words in `HOME`, src/content/site.ts; styles in src/styles/home.css.
 */
import '../styles/home.css';

import BrandMark from '../components/BrandMark.astro';
import SiteIcon from '../components/public-site/SiteIcon.astro';
import {HOME, SITE, withName} from '../content/site';
import Base from '../layouts/Base.astro';
import {minutesLabel, type PublicHome} from '../lib/intelform/api-front';
import type {Site} from '../lib/types';
import {GUEST} from '../platform/auth';
import {backend, read} from '../server/backend';
import {formHref, HOME_FORMS} from '../server/intelform/public-site/shape';

export const prerender = false;

// Both in-process (src/server/backend.ts), at once. No `pageContext`: the page never reads the
// visitor, so one copy serves everyone; `isStatic` below lets the footer fill them in.
const api = backend(Astro.request);
const [brand, home] = await Promise.all([read<{site: Site | null}>(api.site.$get()), read<PublicHome>(api['public-site'].home.$get())]);
const site = brand?.site ?? null;
const name = site?.name ?? 'IntelForm';

if (home) {
  // The same for every visitor: nothing here read the visitor.
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
  if (!home.indexing) Astro.response.headers.set('X-Robots-Tag', 'noindex');
} else {
  // The database could not be read: never cache or index the error page.
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}

const forms = home?.forms ?? [];
const shown = forms.slice(0, HOME_FORMS);
const contactEmail = home?.contactEmail ?? '';
// The owner's own words (Settings, Public site) under the name; never our filler.
const about = home?.description.trim() ?? '';
const description = about || withName(SITE.description, name);
---

<Base site={site} viewer={GUEST} isStatic bare description={description} image={home?.ogImage ?? null} noindex={!home || !home.indexing}>
  <main id="main" tabindex="-1" class="desk">
    <div class="desk-inner">
      <header class="desk-head">
        <BrandMark site={site} size={56} />
        <h1 data-brand-text="{name}">{name}</h1>
        {about && <p class="desk-about">{about}</p>}
      </header>

      {
        !home ? (
          <p class="desk-note" role="alert">
            {HOME.error}
          </p>
        ) : forms.length === 0 ? (
          <p class="desk-note" data-brand-text={HOME.byLink}>
            {withName(HOME.byLink, name)}
          </p>
        ) : (
          <>
            <p class="desk-note">{HOME.listed}</p>
            <section class="desk-forms" aria-labelledby="forms-title">
              <h2 id="forms-title" class="desk-label">
                {HOME.formsHeading}
              </h2>
              <ul class="desk-list">
                {shown.map(form => (
                  <li>
                    <a class="desk-row" href={formHref(form.slug)}>
                      <span class="desk-row-text">
                        <span class="desk-row-title">{form.title}</span>
                        {form.description && <span class="desk-row-desc">{form.description}</span>}
                      </span>
                      {form.minutes ? (
                        <span class="desk-row-time">
                          <SiteIcon name="clock" size={14} />
                          <span class="desk-sr">{minutesLabel(form.minutes)}</span>
                          <span aria-hidden="true">{form.minutes} min</span>
                        </span>
                      ) : null}
                      <SiteIcon name="arrow-right" size={16} class="desk-row-go" />
                    </a>
                  </li>
                ))}
              </ul>
              {forms.length > shown.length && (
                <a class="desk-all" href="/forms/" data-astro-prefetch>
                  {HOME.seeAll.replace('{count}', String(forms.length))}
                </a>
              )}
            </section>
          </>
        )
      }

      {
        contactEmail && (
          <p class="desk-contact">
            {HOME.contact} <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </p>
        )
      }
    </div>
  </main>
</Base>
