---
/**
 * The home page: the creator's public forms hub (legacy src/pages/public/HomePage.tsx). Who you
 * are, the forms open right now, how it works and how to reach you.
 *
 * RENDERED PER VISIT, not prerendered: its forms, contact email, description, social image and
 * whether search engines may index it change in the dashboard without a Publish, and crawlers and
 * link previews must see them in the HTML. It reads no visitor (the header fills the visitor in, in
 * the browser, like a static page), so it may be kept by browsers and caches for a minute, and its
 * data comes from the Site Cache (src/server/intelform/public-site/data.ts): usually no query.
 *
 * Words in `HOME`, `src/content/site.ts`; styles in src/components/public-site/public-site.css.
 */
import '../styles/home.css';
import '../components/public-site/public-site.css';

import FormCard from '../components/public-site/FormCard.astro';
import FormPreview from '../components/public-site/FormPreview.astro';
import SiteIcon from '../components/public-site/SiteIcon.astro';
import {HOME, SITE, withName} from '../content/site';
import Base from '../layouts/Base.astro';
import type {PublicHome} from '../lib/intelform/api-front';
import type {Site} from '../lib/types';
import {GUEST} from '../platform/auth';
import {backend, read} from '../server/backend';
import {formHref, HOME_FORMS} from '../server/intelform/public-site/shape';

export const prerender = false;

// Both in-process (src/server/backend.ts), at once. No `pageContext`: the page never reads the
// visitor, so one copy serves everyone; `isStatic` below lets the header fill them in.
const api = backend(Astro.request);
const [brand, home] = await Promise.all([read<{site: Site | null}>(api.site.$get()), read<PublicHome>(api['public-site'].home.$get())]);
const site = brand?.site ?? null;
const viewer = GUEST;
const name = site?.name ?? 'IntelForm';

if (home) {
  // The same for every visitor: nothing here read the visitor.
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
  if (!home.indexing) Astro.response.headers.set('X-Robots-Tag', 'noindex');
} else {
  // The database could not be read: never cache or index the error page.
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}

const forms = home?.forms ?? [];
const only = forms.length === 1 ? forms[0]! : null;
const more = forms.length > HOME_FORMS;
const contactEmail = home?.contactEmail ?? '';
const description = home?.description || withName(SITE.description, name);
const empty = contactEmail ? HOME.forms.emptyWithEmail.replace('{email}', contactEmail) : HOME.forms.empty;
---

<Base site={site} viewer={viewer} isStatic description={description} image={home?.ogImage ?? null} noindex={!home || !home.indexing}>
  <main id="main" tabindex="-1" class="home ps">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="wrap home-hero-grid">
        <div class="home-hero-copy">
          <h1 id="hero-title" data-brand-text="{name}">{name}</h1>
          <p class="home-lede">{HOME.hero.body}</p>
          <div class="home-actions">
            {
              only ? (
                <a class="button home-button-lg" href={formHref(only.slug)}>
                  {only.title}
                  <SiteIcon name="arrow-right" size={18} />
                </a>
              ) : (
                forms.length > 0 && (
                  <a class="button home-button-lg" href="#forms-title">
                    {HOME.hero.seeForms}
                    <SiteIcon name="arrow-right" size={18} />
                  </a>
                )
              )
            }
            <a class="button ghost home-button-lg" href="/about/" data-astro-prefetch>{HOME.hero.about}</a>
          </div>
        </div>
        <div class="home-hero-visual">
          <FormPreview />
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="forms-title">
      <div class="wrap">
        <div class="home-head home-head-row">
          <div>
            <p class="home-eyebrow">{HOME.forms.eyebrow}</p>
            <h2 id="forms-title">{HOME.forms.title}</h2>
          </div>
          {
            more && (
              <a class="home-more" href="/forms/" data-astro-prefetch>
                {HOME.forms.seeAll.replace('{count}', String(forms.length))}
                <SiteIcon name="arrow-up-right" size={16} />
              </a>
            )
          }
        </div>
        {
          !home ? (
            <p class="notice" role="alert">
              The forms didn’t load. Refresh the page to try again.
            </p>
          ) : forms.length === 0 ? (
            <p class="ps-empty">{empty}</p>
          ) : (
            <ul class="ps-cards">
              {forms.slice(0, HOME_FORMS).map((form, i) => (
                <FormCard form={form} index={i} />
              ))}
            </ul>
          )
        }
        <ul class="ps-facts" aria-label={HOME.goodToKnow.label}>
          <li>
            <SiteIcon name="user-x" size={16} />
            {HOME.goodToKnow.noAccount}
          </li>
          <li>
            <SiteIcon name="monitor-smartphone" size={16} />
            {HOME.goodToKnow.anyDevice}
          </li>
          {
            home?.hasPrivacy && (
              <li>
                <SiteIcon name="shield-check" size={16} />
                <a href="/privacy/" data-astro-prefetch>
                  {HOME.goodToKnow.privacy}
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </section>

    <section class="home-section home-band" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <div class="home-head">
          <p class="home-eyebrow">{HOME.how.eyebrow}</p>
          <h2 id="how-title">{HOME.how.title}</h2>
        </div>
        <ol class="home-steps">
          {
            HOME.how.steps.map((step, i) => (
              <li class="home-step">
                <span class="home-step-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="home-section home-section-last" aria-labelledby="about-title">
      <div class:list={['wrap', 'ps-about', {'ps-about-split': contactEmail}]}>
        <div class="ps-about-copy">
          <p class="home-eyebrow">{HOME.about.eyebrow}</p>
          <h2 id="about-title">{HOME.about.title}</h2>
          <p class="home-sub" data-brand-text={HOME.about.body}>{withName(HOME.about.body, name)}</p>
          <a class="home-more" href="/about/" data-astro-prefetch>
            <span data-brand-text={HOME.about.link}>{withName(HOME.about.link, name)}</span>
            <SiteIcon name="arrow-up-right" size={16} />
          </a>
        </div>
        {
          contactEmail && (
            <div class="ps-contact">
              <span class="ps-contact-icon">
                <SiteIcon name="mail" size={20} />
              </span>
              <h3>{HOME.contact.title}</h3>
              <p class="muted">{HOME.contact.body}</p>
              <a class="ps-contact-email" href={`mailto:${contactEmail}`}>
                {contactEmail}
              </a>
            </div>
          )
        }
      </div>
    </section>
  </main>
</Base>
