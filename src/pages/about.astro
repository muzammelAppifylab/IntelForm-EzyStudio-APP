---
/**
 * /about/ (legacy AboutPage.tsx). Static: built once, served as a file. The words are in `ABOUT`,
 * src/content/site.ts. The contact email (Settings, Public site), the call to action and whether
 * search engines may index the page are filled in after load from `GET /site-api/public-site/home`.
 */
import '../components/public-site/public-site.css';

import BrandMark from '../components/BrandMark.astro';
import SiteIcon from '../components/public-site/SiteIcon.astro';
import {ABOUT, withName} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const name = site?.name ?? 'IntelForm';
---

<Base site={site} viewer={viewer} isStatic title="About" description={withName(ABOUT.lede, name)}>
  <main id="main" tabindex="-1" class="ps" data-public-about>
    <section class="wrap ps-page-intro" aria-labelledby="page-title">
      <div class="ps-intro">
        <BrandMark site={site} size={56} />
        <p class="ps-overline">About</p>
        <h1 id="page-title" data-brand-text={ABOUT.title}>{withName(ABOUT.title, name)}</h1>
        <p class="lede">{withName(ABOUT.lede, name)}</p>
      </div>
    </section>

    <section class="wrap" aria-label="Our story">
      <div class="ps-story">
        {ABOUT.story.map(text => <p data-brand-text={text}>{withName(text, name)}</p>)}
        <p data-about-contact hidden>
          {ABOUT.write}
          <a data-about-email></a>.
        </p>
      </div>
    </section>

    <section class="wrap ps-values-section" aria-labelledby="values-title">
      <p class="ps-overline">{ABOUT.values.eyebrow}</p>
      <h2 id="values-title" class="ps-display">{ABOUT.values.title}</h2>
      <ul class="ps-values">
        {
          ABOUT.values.items.map(v => (
            <li>
              <h3 class="ps-display">{v.title}</h3>
              <p>{v.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap" aria-label="Get started">
      <div class="ps-cta">
        <p class="ps-display" data-about-cta>{ABOUT.cta.ready}</p>
        <a class="button home-button-lg" href="/forms/" data-astro-prefetch>
          {ABOUT.cta.button}
          <SiteIcon name="arrow-right" size={18} />
        </a>
      </div>
    </section>
  </main>
</Base>

<script>
  import type {PublicHome} from '../lib/intelform/api-front';
  import {ABOUT} from '../content/site';
  import {applyIndexing, getJson} from '../components/public-site/client';

  document.addEventListener('astro:page-load', async () => {
    const root = document.querySelector<HTMLElement>('[data-public-about]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const home = await getJson<PublicHome>('/site-api/public-site/home');
    if (!home) return;
    applyIndexing(home.indexing);
    const cta = root.querySelector<HTMLElement>('[data-about-cta]');
    if (cta) cta.textContent = home.forms.length > 0 ? ABOUT.cta.ready : ABOUT.cta.none;
    const contact = root.querySelector<HTMLElement>('[data-about-contact]');
    const email = root.querySelector<HTMLAnchorElement>('[data-about-email]');
    if (contact && email && home.contactEmail) {
      email.href = `mailto:${home.contactEmail}`;
      email.textContent = home.contactEmail;
      contact.hidden = false;
    }
  });
</script>
