---
/**
 * Every `/dashboard/*` URL renders this page; the TanStack Router app inside it
 * picks the screen in the browser. Signed-in users only: the server checks
 * the visitor's own session first, and everyone else gets a sign-in prompt
 * (the Site API checks again on every call — this page is not the guard;
 * the app's shell also sends a signed-out visitor to sign in).
 *
 * The APP layout, not the website's: the portal draws its own full-height
 * shell (sidebar, top bar). The ONLY `.astro` file of the app: never add one
 * per screen.
 */
import App from '../../layouts/App.astro';
import {config} from '../../platform/config';
import {allowFileUploads} from '../../platform/files';
import PortalApp from '../../portal/PortalApp';
import {pageContext} from '../../server/page';

export const prerender = false;

const {site, viewer} = await pageContext(Astro.request, Astro.response);
const back = encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`);
const name = site?.name ?? 'IntelForm';
// "/dashboard/users" -> "Users": names where the visitor was going, so the prompt has context.
// Only the first segment, only plain words (an id or a long slug says nothing to a person).
const segment = Astro.url.pathname.replace(/^\/dashboard\/?/, '').split('/')[0] ?? '';
const destination = /^[a-z]+(?:-[a-z]+){0,2}$/.test(segment)
  ? segment.charAt(0).toUpperCase() + segment.slice(1).replaceAll('-', ' ')
  : null;
// The editor Preview's gateway drops cookies, so this page never sees the
// session there: the app starts anyway and asks `/site-api/me` itself (its
// shell sends a signed-out visitor to sign in).
const open = viewer.state === 'user' || config.preview;
// The builder uploads logos and images straight to storage (src/portal/intelform/builder/api.ts).
if (open) await allowFileUploads(Astro.csp, Astro.url);
---

<App site={site} viewer={viewer} title="Dashboard">
  {
    open ? (
      <>
        <PortalApp client:only="react" />
        <noscript>
          <p class="app-gate">The dashboard needs JavaScript.</p>
        </noscript>
      </>
    ) : (
      <main id="main" tabindex="-1" class="app-gate">
        <div class="app-gate-panel">
          <a class="app-gate-brand" href="/" aria-label={`${name} home`}>
            <span class:list={['app-brand-mark', !site?.logo && 'is-default']} aria-hidden="true">
              <img src={site?.logo || '/brand/mark.svg'} alt="" />
            </span>
            <span class="app-gate-brand-name">{name}</span>
          </a>

          <!-- A session that is only being renewed (App.astro): a short wait, not a sign-in prompt.
               App.astro flips body[data-viewer] to "guest" if the renewal fails, which shows the prompt. -->
          <div class="card app-gate-card app-gate-checking" role="status" aria-live="polite">
            <span class="spinner" aria-hidden="true"></span>
            <p>Checking your session…</p>
          </div>

          <div class="card app-gate-card app-gate-signin">
            <h1>Sign in to continue</h1>
            <p class="app-gate-lede">
              {destination ? (
                <>
                  Sign in to open <strong>{destination}</strong>. You'll come straight back here.
                </>
              ) : (
                <>Sign in to open your {name} dashboard.</>
              )}
            </p>
            <a class="button button-lg button-block" href={`/account/login/?next=${back}`}>
              Sign in
            </a>
            <p class="app-gate-hint">No password needed. We'll email you a 6‑digit code.</p>
            <p class="app-gate-alt">
              New to {name}? <a href={`/account/register/?next=${back}`}>Create an account</a>
            </p>
          </div>

          <a class="app-gate-back" href="/">
            <span aria-hidden="true">←</span> Back to the website
          </a>
        </div>
      </main>
    )
  }
</App>
