---
/**
 * The public site's icons (Lucide shapes), drawn with `currentColor`. Decorative: always
 * `aria-hidden`; the link or button carries the words. No inline `style=""` (CSP).
 */
export type SiteIconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'check'
  | 'clock'
  | 'mail'
  | 'monitor-smartphone'
  | 'shield-check'
  | 'user-x'
  | 'search';

interface Props {
  name: SiteIconName;
  size?: number;
  class?: string;
}

const {name, size = 20, class: className} = Astro.props;
---

<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false">
  {
    name === 'arrow-right' && (
      <>
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </>
    )
  }
  {
    name === 'arrow-up-right' && (
      <>
        <path d="M7 7h10v10" />
        <path d="M7 17 17 7" />
      </>
    )
  }
  {name === 'check' && <path d="M20 6 9 17l-5-5" />}
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="10" />
        <path d="M12 6v6l4 2" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
        <rect x="2" y="4" width="20" height="16" rx="2" />
      </>
    )
  }
  {
    name === 'monitor-smartphone' && (
      <>
        <path d="M18 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8" />
        <path d="M10 19v-3.96 3.15" />
        <path d="M7 19h5" />
        <rect width="6" height="10" x="16" y="12" rx="2" />
      </>
    )
  }
  {
    name === 'shield-check' && (
      <>
        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
        <path d="m9 12 2 2 4-4" />
      </>
    )
  }
  {
    name === 'user-x' && (
      <>
        <path d="M2 21a8 8 0 0 1 11.873-7" />
        <circle cx="10" cy="8" r="5" />
        <path d="m17 17 5 5" />
        <path d="m22 17-5 5" />
      </>
    )
  }
  {
    name === 'search' && (
      <>
        <path d="m21 21-4.34-4.34" />
        <circle cx="11" cy="11" r="8" />
      </>
    )
  }
</svg>
