---
/** A decorative preview of a form next to the home page's headline, so visitors see what they are about to open. */
import {HOME} from '../../content/site';
import SiteIcon from './SiteIcon.astro';

const p = HOME.preview;
---

<div class="ps-preview" aria-hidden="true">
  <div class="ps-preview-track"><span class="ps-preview-fill"></span></div>
  <div class="ps-preview-head">
    <p class="ps-overline">{p.progress}</p>
    <p class="ps-preview-question">{p.question}</p>
  </div>
  <ul class="ps-preview-options">
    {
      p.options.map((label, i) => (
        <li class:list={['ps-preview-option', {selected: i === 0}]}>
          {label}
          {i === 0 && <SiteIcon name="check" size={16} />}
        </li>
      ))
    }
  </ul>
  <div class="ps-preview-foot">
    <span class="ps-preview-time">{p.time}</span>
    <span class="ps-preview-button">
      {p.button}
      <SiteIcon name="arrow-right" size={16} />
    </span>
  </div>
</div>
