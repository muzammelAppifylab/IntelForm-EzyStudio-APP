---
/**
 * The site's logo, when the owner uploaded one; otherwise IntelForm's own mark
 * (`public/brand/mark.svg`, sources in `brand/`). The name beside it is the text,
 * so the default mark is decorative (`alt=""`).
 * `initial-data` carries no description and no brand colour, so name + logo is
 * the whole brand.
 */
import type {Site} from '../lib/types';

interface Props {
  site: Site | null;
  /**
   * One of the sizes `global.css` defines (`.brand-size-<n>`). No `style=""`:
   * the CSP blocks inline style attributes (security.md).
   */
  size?: 32 | 40 | 56 | 64 | 72;
}

const {site, size = 40} = Astro.props;
const name = site?.name ?? 'IntelForm';
---

{
  site?.logo ? (
    <img class:list={['brand-logo', `brand-size-${size}`]} src={site.logo} alt={name} height={size} decoding="async" />
  ) : (
    <img class:list={['brand-logo', 'brand-logo-default', `brand-size-${size}`]} src="/brand/mark.svg" alt="" width={size} height={size} decoding="async" />
  )
}
