---
/**
 * The site's logo, when the owner uploaded one. Without a logo it renders nothing
 * (IntelForm's design: the name in the display face is the brand, no initials circle).
 * `initial-data` carries no description and no brand colour, so name + logo is
 * the whole brand.
 */
import type {Site} from '../lib/types';

interface Props {
  site: Site | null;
  /**
   * One of the sizes `global.css` defines (`.brand-size-<n>`). No `style=""`:
   * the CSP blocks inline style attributes (security.md).
   */
  size?: 32 | 40 | 56 | 64 | 72;
}

const {site, size = 40} = Astro.props;
const name = site?.name ?? 'IntelForm';
---

{site?.logo && <img class:list={['brand-logo', `brand-size-${size}`]} src={site.logo} alt={name} height={size} decoding="async" />}
