{
  "name": "intelform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build && BUILD_TARGET=form vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx --env-file-if-exists=.env server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/db/seed.ts",
    "secrets:reencrypt": "tsx --env-file-if-exists=.env server/db/reencrypt.ts",
    "test:e2e": "playwright test",
    "check:bundle": "tsx e2e/helpers/bundle-size.ts"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@marsidev/react-turnstile": "^1.6.2",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.104.4",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "archiver": "^8.0.0",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "file-type": "^22.2.0",
    "free-email-domains": "^1.15.8",
    "hono": "^4.13.13",
    "immer": "^11.1.21",
    "jsdom": "^30.1.3",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.59.0",
    "nodemailer": "^10.1.7",
