# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string. `npm run db:up` starts one on port 5433 with these credentials.
DATABASE_URL=postgres://intelform:intelform@localhost:5433/intelform

# Long random string (32+ characters). Encrypts secrets stored in app_settings (email
# credentials, Turnstile secret, webhook secrets) and salts IP hashes. Losing it makes stored
# secrets unrecoverable: you would have to enter them again in Settings.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me

# Public URL of the site, no trailing slash. Builds invite and reset links, sets the CSRF origin,
# and an https URL turns on Secure cookies (with the __Host- prefix) and HSTS.
# Required in production.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the server listens on. Vite proxies /api to it in development.
API_PORT=8787

# Apply pending database migrations at startup (safe with several instances: they take a lock).
# The Docker image sets this to 1.
MIGRATE_ON_BOOT=

# pino log level: fatal, error, warn, info (default), debug, trace or silent.
LOG_LEVEL=

# Secret rotation: put the old APP_SECRET here when you change APP_SECRET, so secrets stored
# under the old one still decrypt. Re-save them in Settings, then remove this.
APP_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Proxy and visitor data
# ---------------------------------------------------------------------------

# How many reverse proxies (load balancer, CDN) sit in front of the app. 0 (default) uses the
# connection's address and ignores X-Forwarded-For, which clients can fake. With 1 or more, the
# client IP is taken that many entries from the right of X-Forwarded-For. Rate limits rely on it.
# Required in production behind a proxy or CDN (EzyStudio sets it): left at 0 there, every
# visitor shares the proxy's IP and one rate limit.
TRUSTED_PROXY_HOPS=0

# Header a trusted proxy sets with the visitor's two-letter country code, e.g. CF-IPCountry
# (Cloudflare). Defaults to CF-IPCountry when TRUSTED_PROXY_HOPS > 0; empty = no country.
COUNTRY_HEADER=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# The Owner chooses the provider (SMTP, Resend, Postmark) in Settings → Email.
# This development override wins over Settings: "console" prints emails (invite and reset
# links) to the server log; "none" turns email off. Leave empty in production.
EMAIL_DRIVER=console

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Bunny Edge Storage, provided by EzyStudio. With all three set, uploads go to Bunny and are
# served from the CDN. Leave empty to store uploads on local disk (UPLOADS_DIR).
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
# Region prefix of the storage zone: empty (Falkenstein), ny, la, sg, se, br, jh, syd, uk.
BUNNY_STORAGE_REGION=
# Pull zone URL, e.g. https://intelform.b-cdn.net (also allowed in the image CSP).
BUNNY_CDN_URL=

# Local upload folder, used when Bunny is not configured. Served at /api/uploads/files/*.
UPLOADS_DIR=./uploads

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Let webhooks reach localhost and private networks (refused in production).
ALLOW_PRIVATE_WEBHOOKS=

# Tests: base database for server integration tests (a template <name>_tpl and one database per
# test file are created next to it) and the database e2e tests recreate on every run.
TEST_DATABASE_URL=
E2E_DATABASE_URL=
