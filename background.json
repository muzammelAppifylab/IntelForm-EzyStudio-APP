{
  "lists": {
    "intelform-every-minute": {
      "retries": 0,
      "concurrency": 5
    },
    "intelform-response-notify": {
      "retries": 4,
      "concurrency": 10
    },
    "intelform-webhook-deliver": {
      "retries": 4,
      "concurrency": 5
    },
    "intelform-webhooks": {
      "retries": 2,
      "concurrency": 5
    },
    "intelform-retention": {
      "retries": 2,
      "concurrency": 1
    },
    "intelform-maintenance": {
      "retries": 1,
      "concurrency": 1
    },
    "intelform-file-cleanup": {
      "retries": 2,
      "concurrency": 1
    },
    "intelform-exports": {
      "retries": 3,
      "concurrency": 3
    }
  },
  "schedules": {
    "intelform-every-minute": {
      "every": "minute",
      "label": "IntelForm: send response notifications and webhooks, refresh form counts and summaries"
    },
    "intelform-retention": {
      "cron": "30 * * * *",
      "label": "IntelForm: delete responses past the retention period"
    },
    "intelform-maintenance": {
      "every": "hour",
      "label": "IntelForm: close forms past their close date, owner digests, trim logs and old counts"
    }
  }
}
